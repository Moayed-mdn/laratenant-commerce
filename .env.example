NEXT_PUBLIC_API_URL=http://your-api-url
NEXT_PUBLIC_APP_NAME=Admin Dashboard
NEXT_PUBLIC_BASE_DOMAIN=laratenant.local
NEXT_PUBLIC_SITE_URL=http://laratenant.local:3000
NEXT_PUBLIC_STOREFRONT_RUNTIME_VERSION=2026-06-26
API_URL=http://your-api-url

# Firebase Web push notifications (all NEXT_PUBLIC_ values here are the
# public Firebase *web app* config — safe to expose client-side by design,
# NOT the server-side service account used by the backend. Leave empty to
# keep the in-app notification center working while disabling web push.
# See docs/notifications/WEB_PUSH_SETUP.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
